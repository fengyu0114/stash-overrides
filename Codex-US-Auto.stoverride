name: Codex ChatGPT Auto
desc: Codex/ChatGPT 使用美国或日本节点自动测速
# https://raw.githubusercontent.com/fengyu0114/stash-overrides/main/Codex-US-Auto.stoverride
mode: rule

proxy-groups:
  - name: Codex-AI
    type: url-test
    include-all: true
    filter: "(?i)(美国|日本|Relay-US|Relay-JP|\\bUS\\b|\\bJP\\b|USA|United States|Japan|🇺🇸|🇺🇲|🇯🇵)"
    url: http://www.gstatic.com/generate_204
    interval: 60
    tolerance: 0
    lazy: false

rules:
  # Codex CLI / 旧 Codex Desktop / 新 ChatGPT Desktop
  - PROCESS-NAME,codex,Codex-AI
  - PROCESS-NAME,Codex,Codex-AI
  - PROCESS-NAME,Codex (Service),Codex-AI
  - PROCESS-NAME,ChatGPT,Codex-AI
  - PROCESS-NAME,ChatGPT (Service),Codex-AI
  - PROCESS-PATH,/Applications/Codex.app/Contents/MacOS/Codex,Codex-AI
  - PROCESS-PATH,/Applications/ChatGPT.app/Contents/MacOS/ChatGPT,Codex-AI

  # OpenAI / ChatGPT 域名兜底
  - DOMAIN-SUFFIX,chatgpt.com,Codex-AI
  - DOMAIN-SUFFIX,openai.com,Codex-AI
  - DOMAIN-SUFFIX,oaistatic.com,Codex-AI
  - DOMAIN-SUFFIX,oaiusercontent.com,Codex-AI
